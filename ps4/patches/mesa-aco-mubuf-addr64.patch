+/* PS4 (AI-assisted, PCSX2 PS4 port): GFX7 global memory (buffer device addresses) through MUBUF with addr64, as on
+ * GFX6, instead of FLAT. A FLAT address is global memory only outside the LDS and scratch apertures (SH_MEM_BASES),
+ * which the Orbis kernel sets up for its own GNM shaders, not for RADV's addresses: paraLLEl-GS's first FLAT store hung
+ * the GPU. MUBUF addr64 needs no aperture (it is how LLVM reached global memory on CIK under Mesa). Needs proper
+ * testing. */
+static inline bool
+mubuf_addr64_global(amd_gfx_level gfx_level)
+{
+#if defined(__PS4__)
+   return gfx_level <= GFX7;
+#else
+   return gfx_level == GFX6;
+#endif
+}
