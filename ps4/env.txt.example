# /data/LibertyRecomp/env.txt - read by the PS4 build at start-up (NAME=value, # = comment).
# Any cvar can be set as REX_<UPPERCASE CVAR NAME>.

# Performance mode: redraw shadow cascades / reflection passes every N frames
# (PS4 default 2; 1 = every frame, 0 = never).
REX_GTA4_NATIVE_SHADOW_UPDATE_INTERVAL=0
REX_GTA4_NATIVE_REFLECTION_UPDATE_INTERVAL=3
# Pipeline prewarm repeats each draw's target and pipeline lookup on the same worker thread.
REX_GTA4_NATIVE_PIPELINE_PREWARM=false

# Native renderer profiler (then create an empty /data/LibertyRecomp/profile-start during play):
# REX_DIAGNOSTICS=true
# REX_DIAGNOSTICS_CATEGORIES=logging,native-profiler
# REX_GTA4_PROFILE_NATIVE_AUTOSTART=false
# REX_GTA4_PROFILE_NATIVE_SAMPLES=60
